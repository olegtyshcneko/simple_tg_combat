{
	"name": "simple-tg-combat",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"telegram:commands:set": "node --env-file=.env scripts/set-commands.mjs",
		"telegram:webhook:set": "node --env-file=.env scripts/set-webhook.mjs",
		"telegram:menubutton:set": "node --env-file=.env scripts/set-menubutton.mjs"
	},
 "devDependencies": {
 	"@sveltejs/adapter-node": "^5.2.11",
 	"@sveltejs/kit": "^2.47.1",
 	"@sveltejs/vite-plugin-svelte": "^6.2.1",
 	"@types/node": "^22.10.7",
 	"svelte": "^5.41.0",
 	"svelte-check": "^4.3.3",
 	"typescript": "^5.9.3",
 	"vite": "^7.1.10"
 }
}
